# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Server Port
PORT=5000

# Client Frontend URL (for CORS restriction)
CLIENT_URL=https://gameconnect.app

# Managed Redis URL (for scaling Socket.IO across multiple backend instances)
# e.g., rediss://default:<password>@<host>:<port> (Upstash, Render Redis, Redis Cloud)
REDIS_URL=redis://localhost:6379

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Credentials (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail SMTP Credentials for OTP Verification
# Use your Gmail address and a 16-character Google App Password (NOT your account password)
# Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
